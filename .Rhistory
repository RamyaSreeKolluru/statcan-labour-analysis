# Question 1(c): Maximum Sharpe Ratio Portfolio
# Monthly risk-free rate
rf_annual  <- 0.04
rf_monthly <- rf_annual / 12
# Extract forecasted means and covariance matrices
mu_geo <- as.numeric(forecast_geo@mforecast$mu)
sigma_geo <- matrix(forecast_geo@mforecast$H[[1]], nrow = 5, ncol = 5)
colnames(sigma_geo) <- portfolio_geo
rownames(sigma_geo) <- portfolio_geo
names(mu_geo) <- portfolio_geo
